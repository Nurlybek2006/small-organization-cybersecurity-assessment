{
  "name": "small-organization-cybersecurity-assessment",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --filter @cyberguard/shared build && pnpm --parallel --filter @cyberguard/backend --filter @cyberguard/frontend dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @cyberguard/backend db:migrate",
    "db:seed": "pnpm --filter @cyberguard/backend db:seed",
    "db:generate": "pnpm --filter @cyberguard/backend db:generate"
  },
  "devDependencies": {
    "prettier": "3.4.2",
    "typescript": "5.7.3"
  }
}
